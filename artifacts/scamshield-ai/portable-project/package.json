{
  "name": "scamshield-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Scam and phishing message analysis dashboard",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace @scamshield/server",
    "dev:client": "npm run dev --workspace @scamshield/client",
    "build": "npm run build --workspace @scamshield/client",
    "start": "npm run start --workspace @scamshield/server",
    "start:server": "npm run start --workspace @scamshield/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
